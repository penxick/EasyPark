# Local development only. Copy to .env and set your own password.
POSTGRES_DB=easypark
POSTGRES_USER=easypark
POSTGRES_PASSWORD=easypark_local_change_me
POSTGRES_PORT=55432
BACKEND_PORT=3000
DB_HOST=127.0.0.1
CV_PORT=8000
# Custom YOLO detection weights: /app/models/best.pt (container path).
MODEL_PATH=/app/weights/yolo11n.pt
JWT_SECRET=replace_with_random_secret_at_least_32_bytes
# Access token lifetime: 7 days. Allowed range: 60..2592000 seconds.
JWT_TTL_SECONDS=604800

